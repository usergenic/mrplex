{
  "name": "@mrplex/embedder",
  "version": "0.1.3",
  "description": "Local CPU embedding provider for mrplex's --embedder hook (bge-small-en-v1.5 via fastembed). Isolated from mrplex core so fastembed/tar stay out of the core dependency graph.",
  "type": "module",
  "license": "MIT",
  "author": "Brendan Baldwin <brendan@usergenic.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usergenic/mrplex.git",
    "directory": "packages/embedder"
  },
  "homepage": "https://github.com/usergenic/mrplex/tree/main/packages/embedder",
  "bugs": {
    "url": "https://github.com/usergenic/mrplex/issues"
  },
  "keywords": [
    "mrplex",
    "embeddings",
    "semantic-search",
    "fastembed",
    "onnx",
    "bge"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mrplex-embedder": "embedder.mjs"
  },
  "files": [
    "embedder.mjs",
    "README.md"
  ],
  "scripts": {
    "pretest": "node -e \"try{require.resolve('fastembed')}catch{console.error('pretest: run npm install first');process.exit(1)}\"",
    "start": "node embedder.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "fastembed": "^2.1.0"
  }
}
