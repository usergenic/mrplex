{
  "name": "mrplex",
  "version": "0.0.0",
  "description": "Markdown Repos, plexed. A hub for versioned markdown.",
  "type": "module",
  "bin": {
    "mrplex": "./dist/cli/main.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/main.ts",
    "seed": "tsx scripts/seed.ts",
    "pg:up": "docker compose --profile postgres up -d",
    "pg:down": "docker compose --profile postgres down",
    "pg:reset": "docker compose --profile postgres down -v && docker compose --profile postgres up -d",
    "pg:logs": "docker compose --profile postgres logs -f postgres"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@bufbuild/cel": "^0.6.0",
    "@bufbuild/re2": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "micromark": "^4.0.2",
    "pg": "^8.23.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
